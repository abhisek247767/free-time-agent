# Copy to .env and edit. Real environment variables override values here.
# Leave a value empty to use the built-in default.

# --- General ---
FREE_TIME_AGENT_DATA=./data
FREE_TIME_AGENT_USER_AGENT=free-time-agent/0.1 (personal hobby project)
HTTP_TIMEOUT_S=20

# --- Weather (Open-Meteo, no key) ---
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Geocoding (Nominatim, no key) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Seconds between requests. Nominatim policy: at least 1.0 (lower values are raised to 1.0).
NOMINATIM_MIN_INTERVAL_S=1.0

# --- Green spaces (Overpass, no key) ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_S=40
# Retries for 429/504 responses from the public server.
OVERPASS_ATTEMPTS=2
OVERPASS_RETRY_DELAY_S=3

# --- Walking routes ---
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot
ORS_URL=https://api.openrouteservice.org/v2/directions/foot-walking
# Free key from openrouteservice.org; leave empty to skip ORS.
ORS_API_KEY=
# Offline fallback: straight-line distance multiplied by this.
ROUTE_DETOUR_FACTOR=1.3

# --- Local LLMs (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
# Router: decision model called via /v1/systemone; picks the action, never writes the answer.
ROUTER_MODEL=tev1:0.8b
ROUTER_TIMEOUT_S=120
# Appended to extracted place names before geocoding, e.g. Hyderabad. Empty to skip.
HOME_CITY=
# Responder: writes the final 3-sentence answer; also extracts place names when regex fails.
RESPONSE_MODEL=qwen2.5:3b
RESPONSE_TEMPERATURE=0.3
